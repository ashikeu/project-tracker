{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ProjectTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "ProjectTracker.Api",
    "Audience": "ProjectTracker.Client",
    "SigningKey": "REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS_LONG_IN_APPSETTINGS_DEVELOPMENT_OR_ENV_VARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromAddress": "no-reply@projecttracker.local",
    "FromName": "Project Tracker"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeBytes": 26214400,
    "AllowedContentTypes": []
  }
}
